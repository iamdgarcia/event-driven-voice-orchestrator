# Event-Driven Voice Orchestrator — example environment
# Copy to .env and fill in. The CORE library needs none of these:
#   python -m examples.terminal_demo --demo   runs with zero configuration.
# Only examples/openai_demo.py reads this file (10-line stdlib loader).

# Required for the real-model demo (examples/openai_demo.py)
OPENAI_API_KEY=sk-...

# Optional: model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: simulated tool round-trip in seconds (default: 1.5)
# DEMO_TOOL_RTT_S=1.5
